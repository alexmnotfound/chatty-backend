generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  active           Boolean  @default(false)
  stripeCustomerId String?  @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")

  bots          Bot[]
  members       CompanyMember[]
  contacts      Contact[]
  conversations Conversation[]
  messages      Message[]
  botExamples   BotExample[]

  @@map("companies")
}

model CompanyMember {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  // user_id references auth.users managed by Supabase Auth — no Prisma relation possible
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("agent")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@map("company_members")
}

model Bot {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @map("company_id") @db.Uuid
  name                   String
  whatsappPhoneNumberId  String?  @map("whatsapp_phone_number_id")
  whatsappAccessTokenEnc String?  @map("whatsapp_access_token_enc")
  whatsappAppSecretEnc   String?  @map("whatsapp_app_secret_enc")
  aiProvider             String?  @map("ai_provider")
  aiApiKeyEnc            String?  @map("ai_api_key_enc")
  aiModel                String?  @map("ai_model")
  systemPrompt           String?  @map("system_prompt") @db.Text
  gender                 String   @default("neutral")
  tone                   String   @default("informal")
  active                 Boolean  @default(false)
  createdAt              DateTime @default(now()) @map("created_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  examples      BotExample[]
  conversations Conversation[]
  messages      Message[]

  @@index([companyId])
  @@map("bots")
}

model BotExample {
  id          String @id @default(uuid()) @db.Uuid
  botId       String @map("bot_id") @db.Uuid
  companyId   String @map("company_id") @db.Uuid
  userMessage String @map("user_message") @db.Text
  botResponse String @map("bot_response") @db.Text
  order       Int    @default(0)

  bot     Bot     @relation(fields: [botId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([companyId])
  @@map("bot_examples")
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  waId      String   @map("wa_id")
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([companyId, waId])
  @@index([companyId])
  @@map("contacts")
}

model Conversation {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  contactId   String   @map("contact_id") @db.Uuid
  activeBotId String?  @map("active_bot_id") @db.Uuid
  status      String   @default("ai")
  unreadCount Int      @default(0) @map("unread_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  activeBot Bot?      @relation(fields: [activeBotId], references: [id])
  messages  Message[]

  @@index([companyId])
  @@index([contactId])
  @@index([activeBotId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  direction      String
  body           String   @db.Text
  fromAi         Boolean  @default(false) @map("from_ai")
  botId          String?  @map("bot_id") @db.Uuid
  tokensIn       Int?     @map("tokens_in")
  tokensOut      Int?     @map("tokens_out")
  model          String?
  costUsd        Decimal? @map("cost_usd") @db.Decimal(10, 6)
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bot          Bot?         @relation(fields: [botId], references: [id])

  @@index([conversationId])
  @@index([companyId])
  @@index([botId])
  @@map("messages")
}

model SuperAdmin {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  name      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("super_admins")
}
